{
    "name": "gupalo/config-bundle",
    "description": "Editable config rows backed by an EasyAdmin CRUD",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.0",
        "easycorp/easyadmin-bundle": "^5.0",
        "gupalo/dateutils": "^1.20",
        "symfony/cache": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0",
        "twig/twig": "^3.22"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.4"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Gupalo\\ConfigBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gupalo\\ConfigBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyze"
    }
}
